{
  "name": "@keelson/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "keelson-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-view.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@keelson/agent": "workspace:*",
    "@keelson/alibi": "workspace:*",
    "@keelson/core": "workspace:*",
    "@keelson/evidence": "workspace:*",
    "@keelson/interop": "workspace:*",
    "@keelson/mandate": "workspace:*",
    "@keelson/policy": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "ulid": "3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@keelson/ui": "workspace:*",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
