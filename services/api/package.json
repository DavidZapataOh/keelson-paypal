{
  "name": "@keelson/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/chain/vendor dist/chain/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "openapi": "node scripts/openapi.ts",
    "bench": "pnpm run build && node bench/health.bench.ts",
    "budgets": "KEELSON_BUDGETS=1 vitest run test/mandates.test.ts -t \"latency budget\"",
    "test:live": "KEELSON_LIVE=1 vitest run test/compile.test.ts",
    "bench:countersign": "node bench/countersign.bench.ts",
    "bench:log-append": "node bench/log-append.bench.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@aws-sdk/client-kms": "catalog:",
    "@better-auth/drizzle-adapter": "1.7.17",
    "@better-auth/oauth-provider": "1.7.17",
    "@better-auth/passkey": "1.7.17",
    "@channel3/sdk": "4.8.0",
    "@hono/node-server": "2.1.6",
    "@hono/otel": "1.3.0",
    "@hono/zod-openapi": "1.6.3",
    "@keelson/attest": "workspace:*",
    "@keelson/chain": "workspace:*",
    "@keelson/compiler": "workspace:*",
    "@keelson/core": "workspace:*",
    "@keelson/db": "workspace:*",
    "@keelson/erc8004": "workspace:*",
    "@keelson/evidence": "workspace:*",
    "@keelson/log": "workspace:*",
    "@keelson/mandate": "workspace:*",
    "@keelson/paypal": "workspace:*",
    "@keelson/policy": "workspace:*",
    "@keelson/relayer": "workspace:*",
    "@keelson/timestamp": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@simplewebauthn/server": "13.3.3",
    "age-encryption": "0.3.1",
    "better-auth": "1.7.17",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "pino": "10.4.0",
    "redis": "6.3.1",
    "svix": "2.9.1",
    "ulid": "3.0.2",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/autocannon": "7.12.7",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "autocannon": "8.0.0",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "playwright": "1.64.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
