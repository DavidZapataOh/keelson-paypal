{
  "name": "@keelson/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/chain/vendor dist/chain/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --import ./dist/telemetry.js dist/server.js",
    "openapi": "node scripts/openapi.ts && node scripts/public-openapi.ts",
    "bench": "pnpm run build && node bench/health.bench.ts",
    "budgets": "KEELSON_BUDGETS=1 vitest run test/mandates.test.ts -t \"latency budget\"",
    "test:live": "KEELSON_LIVE=1 vitest run test/compile.test.ts test/dispute-drafter.live.test.ts",
    "bench:checkout": "node bench/checkout.bench.ts",
    "bench:countersign": "node bench/countersign.bench.ts",
    "bench:hold": "node bench/hold.bench.ts",
    "bench:log-append": "node bench/log-append.bench.ts",
    "bench:money-path": "node bench/money-path.bench.ts",
    "workflows": "node dist/workflows.js",
    "bench:shopping-agent": "node bench/shopping-agent.bench.ts",
    "postman": "node scripts/postman.ts"
  },
  "dependencies": {
