    "$defs": {
      "allColumnIds": {
        "type": "string",
        "description": "createdAt: When the purchase was made (UTC).\nmerchantId: The store's Keelson id, e.g. mrc_runfast.\namount: The purchase amount, in US dollars.\npremiumBps: The premium in basis points of the amount.\npremium: The premium Keelson charged on the coverage, in US dollars.\nstate: The purchase's lifecycle state.\ndisputeState: The PayPal dispute's state; blank if never disputed.\nliable: Who the signed verdict found liable. 'operator' rows are slashes.\noutcome: What happened to the verdict's payment.\npaidBy: Who paid the verdict.\nid",
        "enum": [
          "createdAt",
          "merchantId",
          "amount",
          "premiumBps",
          "premium",
          "state",
          "disputeState",
          "liable",
          "outcome",
          "paidBy",
          "id"
        ]
      }
    }
