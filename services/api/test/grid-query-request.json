        "required": ["hiddenColIds"],
        "additionalProperties": false,
        "properties": {
          "hiddenColIds": {
            "type": "array",
            "description": "Array of column IDs to hide",
            "items": { "$ref": "#/$defs/allColumnIds" }
          }
        }
