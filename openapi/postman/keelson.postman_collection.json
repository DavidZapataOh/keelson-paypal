    {
      "name": "alibis",
      "item": [
        {
          "name": "An Alibi as a PDF/A-3b",
          "request": {
            "name": "An Alibi as a PDF/A-3b",
            "description": {
              "content": "A one-page PDF/A-3b summary of the Alibi with a QR to its verify page and the bundle embedded as `<id>.alibi`. Same readers, and the same public copy, as the bundle.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "alibis",
                "{{purchaseId}}.pdf"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "method": "GET"
          },
          "response": []
        },
        {
          "name": "An Alibi bundle",
          "request": {
            "name": "An Alibi bundle",
            "description": {
              "content": "The purchase's Alibi: its RFC 8785 bundle, readable by the mandate's user or, with `alibis:read`, by the client that uploaded the purchase's evidence; the Alibi of a live purchase, once its PayPal transaction is recorded, by anyone. Anyone else gets its public copy, whose mandate withholds the user's login id and risk data: their salted digests stay in the signed payload, so the copy verifies the same. It grows as timestamps, the capture and the on-chain anchor arrive; earlier sections never change.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "alibis",
                "{{purchaseId}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
