                "key": "Accept",
                "value": "application/vnd.keelson.alibi.v1+json"
              }
            ],
            "method": "GET"
          },
          "response": []
        },
        {
          "name": "Verify an Alibi",
          "request": {
            "name": "Verify an Alibi",
            "description": {
              "content": "Runs the browser verifier's algorithm on an Alibi bundle against the pinned trust roots and a public Arbitrum RPC. No authentication; the bundle is not stored.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "alibis",
