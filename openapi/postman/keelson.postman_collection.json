    {
      "name": "evidence",
      "item": [
        {
          "name": "Store sealed evidence",
          "request": {
            "name": "Store sealed evidence",
            "description": {
              "content": "Stores what the agent saw at decision time for an active mandate of an operator this client linked or, for an app acting for a user, one that user approved for the app. The manifest is rebuilt from the items and must match, every item has its own salt, no public item may still hold an email address or phone number, and every `.original` must open with the evidence identity. A countersign may only bind a stored root, once.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "evidence"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mandateId\": \"<string>\",\n  \"manifest\": {\n    \"v\": \"<string>\",\n    \"root\": \"<string>\",\n    \"items\": [\n      {\n        \"type\": \"<string>\",\n        \"media_type\": \"<string>\",\n        \"leaf\": \"<string>\"\n      }\n    ]\n  },\n  \"items\": [\n    {\n      \"type\": \"<string>\",\n      \"mediaType\": \"<string>\",\n      \"salt\": \"<string>\",\n      \"bytes\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Read an evidence manifest",
          "request": {
            "name": "Read an evidence manifest",
            "description": {
              "content": "The public manifest of a stored bundle: salted leaves only.",
              "type": "text/plain"
