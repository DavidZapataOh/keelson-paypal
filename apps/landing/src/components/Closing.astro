---
import { apiReferenceUrl, appUrl, monitorUrl, repoUrl, storeUrl, verifyUrl } from "../config";

const columns = [
  {
    title: "Product",
    links: [
      { label: "App", href: appUrl },
      { label: "Alibi verifier", href: verifyUrl },
      { label: "Demo store", href: storeUrl },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "Repository", href: repoUrl },
      { label: "API reference", href: apiReferenceUrl },
      { label: "Contracts", href: `${repoUrl}/tree/main/contracts` },
    ],
  },
  {
    title: "Status",
    links: [
      { label: "System status", href: `${appUrl}/status/` },
      { label: "Log monitor", href: monitorUrl },
      { label: "Issues", href: `${repoUrl}/issues` },
    ],
  },
];
---

<section class="closing ticks" aria-labelledby="closing-title">
  <div class="wrap inner">
    <div class="seal-stage" id="closing-stage" data-ready="false" aria-hidden="true">
      <canvas width="1440" height="200"></canvas>
      <div class="split"><i class="l"></i><i class="r"></i></div>
    </div>
    <h2 id="closing-title">Proof before<br /><span class="hl">payment.</span></h2>
    <div class="cta">
      <a class="btn btn-dark" href={appUrl}>
        Try the demo
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>
      </a>
      <a class="link" href={repoUrl}>Read the code</a>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap">
    <div class="row">
      <a class="brand" href="#top" aria-label="Keelson, back to top"><img src="/keelson.svg" alt="" width="190" height="56" /></a>
      <nav aria-label="Footer">
        {
          columns.map((c) => (
            <div class="col">
              <p class="col-title mono">{c.title}</p>
              <ul>
                {c.links.map((l) => (
                  <li>
                    <a class="link" href={l.href}>
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <p class="legal mono">Everything runs on the PayPal sandbox and Arbitrum Sepolia. No real money moves.</p>
    <p class="legal mono">Keelson is an independent project. It is not affiliated with or endorsed by PayPal.</p>
    <p class="legal mono">Keelson is not insurance. PayPal decides disputes on its own platform.</p>
  </div>
</footer>

<style>
  .closing {
    position: relative;
    padding-block: clamp(96px, 14vw, 200px);
    text-align: center;
    overflow: hidden;
  }

  .inner {
    display: grid;
    justify-items: center;
  }

  .seal-stage {
    position: relative;
    justify-self: stretch;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-bottom: clamp(24px, 4vw, 48px);
    aspect-ratio: 1440 / 200;
    display: grid;
    align-items: center;
  }

  .seal-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .seal-stage[data-ready="true"] canvas {
    opacity: 1;
  }

  .seal-stage[data-ready="true"] .split {
    visibility: hidden;
  }

  .split {
    display: flex;
    width: 100%;
    height: 20%;
  }

  .split i {
    flex: 1;
    background: var(--vermilion);
  }

  .split .l {
    clip-path: polygon(0 0, calc(100% - 40px) 0, 100% 100%, 0 100%);
    margin-right: clamp(16px, 5vw, 64px);
    transform-origin: left;
  }

  .split .r {
    clip-path: polygon(40px 0, 100% 0, 100% 100%, 0 100%);
    margin-left: clamp(16px, 5vw, 64px);
    transform-origin: right;
  }

  h2 {
    font-size: clamp(3.4rem, 11vw, 9.5rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .cta {
    margin-top: clamp(32px, 4vw, 56px);
    display: grid;
    justify-items: center;
    gap: 8px;
  }

  .foot {
    border-top: 1px solid var(--line);
    padding-block: 40px 56px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px 48px;
  }

  .brand img {
    height: 44px;
    width: auto;
  }

  nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(10rem, auto));
    gap: 24px 56px;
  }

  .col-title {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  ul {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }

  @media (max-width: 640px) {
    nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .legal {
    margin-top: 12px;
    font-size: 0.8rem;
    color: var(--text-2);
  }

  .row + .legal {
    margin-top: 32px;
  }
</style>
