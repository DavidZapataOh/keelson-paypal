---
import { appUrl } from "../config";
---

<section class="hero ticks" id="top" aria-labelledby="hero-title">
  <div class="wrap layout">
    <div class="copy">
      <h1 id="hero-title">Your agent buys wrong.<br />The party at fault <span class="hl">pays.</span></h1>
      <p class="sub">
        Keelson checks every AI-agent purchase against what you signed before it's paid, and seals
        it with an Alibi anyone can verify.
      </p>
      <div class="cta">
        <a class="btn" href={appUrl}>
          Try the demo
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>
        </a>
        <a class="link" href="#cheat">Tamper with a real Alibi</a>
      </div>
    </div>

    <figure class="stage" id="hero-stage" data-ready="false">
      <div class="frame">
        <canvas id="hero-rive" width="640" height="470" aria-hidden="true"></canvas>

        <!-- Shown until the animation is ready, and instead of it without JS or with reduced motion -->
        <div class="ledger" aria-hidden="true">
          <div class="rows mono">
            <span><b>MANDATE</b></span><span>SHOES · SIZE 10 · MAX $100</span>
            <span><b>CART</b></span><span>$340.00 · BUNDLE DEAL</span>
            <span><b>CHECK</b></span><span>TOTAL EXCEEDS MAX $100</span>
            <span><b>PAID</b></span><span>$0.00</span>
            <span><b>STATUS</b></span><span><i class="seal">BLOCKED</i></span>
          </div>
        </div>
      </div>

      <figcaption>
        <p class="sr" id="hero-live" aria-live="polite">
          An agent checks out under a mandate of shoes, size 10, at most 100 dollars. Keelson
          countersigns the 94 dollar cart and it is paid.
        </p>
        <div class="controls" role="group" aria-label="Replay the checkout">
          <button class="toggle" type="button" data-value="false" aria-pressed="true">
            <i class="dot ok" aria-hidden="true"></i>Clean purchase
          </button>
          <button class="toggle" type="button" data-value="true" aria-pressed="false">
            <i class="dot bad" aria-hidden="true"></i>Inject an attack
          </button>
        </div>
        <span class="note mono">Synthetic demonstration</span>
      </figcaption>
    </figure>
  </div>

  <p class="foot mono">The liability layer for AI-agent purchases on PayPal</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 24px);
    padding-bottom: 96px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }

  h1 {
    font-size: clamp(2.5rem, 5.3vw, 5.25rem);
    max-width: 11ch;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .sub {
    margin-top: clamp(24px, 3vw, 40px);
    max-width: 34ch;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .cta {
    margin-top: clamp(28px, 3.4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }

  /* The stage */
  .stage {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 640 / 470;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }

  .stage[data-ready="true"] canvas {
    opacity: 1;
  }

  .ledger {
    position: absolute;
    inset: 4.3% 9.4% 12.8% 3.1%;
    display: grid;
    align-content: center;
    padding: 20px 24px;
    border: 1.5px solid var(--graphite);
    border-radius: var(--radius-l);
    background: var(--bone);
    transition: opacity 300ms ease;
  }

  .stage[data-ready="true"] .ledger {
    opacity: 0;
    visibility: hidden;
  }

  .rows {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 28px;
    row-gap: 10px;
    font-size: clamp(0.8rem, 1.05vw, 1rem);
    line-height: 1.6;
  }

  .rows b {
    font-weight: 500;
    color: var(--text-2);
  }

  .seal {
    font-style: normal;
    background: var(--vermilion);
    padding: 0 8px;
    border-radius: 2px;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-top: -6%;
    padding-inline: 3.1% 9.4%;
    position: relative;
  }

  .controls {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--bone);
  }

  .stage[data-ready="false"] .controls {
    display: none;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    font: 500 0.92rem / 1 var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-hover) ease,
      color var(--dur-hover) ease;
  }

  .toggle:hover {
    color: var(--graphite);
  }

  .toggle[aria-pressed="true"] {
    background: var(--graphite);
    color: var(--bone);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot.ok {
    background: #4fbf8f;
  }

  .dot.bad {
    background: var(--vermilion);
  }

  .note {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .foot {
    position: absolute;
    left: var(--gutter);
    bottom: 28px;
    z-index: 2;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  /* narrow screens get the tall artboard */
  @media (max-width: 700px) {
    .frame {
      aspect-ratio: 360 / 480;
    }

    .ledger {
      inset: 4% 6% 6% 6%;
    }
  }

  @media (max-width: 980px) {
    .hero {
      align-items: flex-start;
      padding-bottom: 112px;
    }

    .layout {
      grid-template-columns: 1fr;
    }

    .stage {
      margin-inline: calc(var(--gutter) * -0.6);
    }

    figcaption {
      margin-top: -4%;
    }

    .toggle {
      padding: 0 12px;
      font-size: 0.85rem;
    }
  }
</style>
