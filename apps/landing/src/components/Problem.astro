---
const transcript = [
  { who: "You", text: "Running shoes, size 10, under $100." },
  { who: "Agent", text: "Found a pair for $94. Ordered. Trail runner, US 10, paid Monday 09:14." },
  { who: "You", text: "They sent a size 11. Delivered Thursday: ordered US 10, got US 11." },
  { who: "Agent", text: "I ordered what the listing showed." },
  { who: "Store", text: "The order matches the listing." },
  { who: "Card rules", text: "The cardholder answers for the agent." },
  { who: "You", text: "So who pays for this?" },
  { who: "Agent", text: "No answer." },
];
---

<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="wrap grid">
    <div class="lede">
      <h2 id="problem-title">Your agent bought the wrong thing. Who pays?</h2>
      <p>
        Today, you do. Card rules hold the cardholder responsible for what the agent buys, and no
        one kept proof of what you actually asked for.
      </p>
    </div>

    <figure class="stage" id="problem-stage" data-ready="false">
      <div class="frame">
        <canvas id="problem-rive" width="560" height="640" aria-hidden="true"></canvas>
        <ol class="transcript" aria-label="A synthetic agent purchase that went wrong">
          {
            transcript.map((m) => (
              <li class={m.who === "You" ? "you" : m.who === "Card rules" ? "rule" : "them"}>
                <span class="who mono">{m.who}</span>
                <span class="text">{m.text}</span>
              </li>
            ))
          }
          <li class="loss mono">You carry the loss · −$94.00</li>
        </ol>
      </div>
    </figure>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  h2 {
    font-size: clamp(2.6rem, 5.4vw, 5rem);
  }

  .lede p {
    margin-top: 28px;
    max-width: 32ch;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .stage {
    margin: 0;
    width: 100%;
    max-width: 600px;
    justify-self: end;
  }

  .frame {
    position: relative;
    aspect-ratio: 560 / 640;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }

  .stage[data-ready="true"] canvas {
    opacity: 1;
  }

  /* The transcript: the page's text, and what shows without the animation */
  .transcript {
    position: absolute;
    inset: 3% 3.6%;
    list-style: none;
    margin: 0;
    padding: 24px;
    display: grid;
    align-content: start;
    gap: 12px;
    overflow: hidden;
    border: 1.5px solid var(--graphite);
    border-radius: 18px;
    background: #fff;
  }

  .transcript li {
    display: grid;
    gap: 2px;
    max-width: 78%;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--bone-2);
  }

  .transcript .you {
    justify-self: end;
    background: var(--graphite);
    color: var(--bone);
  }

  .transcript .rule {
    justify-self: center;
    background: var(--bone);
    font-size: 0.85rem;
  }

  .transcript .who {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .transcript .loss {
    max-width: none;
    margin-top: 8px;
    background: var(--vermilion);
    color: var(--graphite);
    font-weight: 600;
    text-transform: uppercase;
  }

  .stage[data-ready="true"] .transcript {
    clip-path: inset(50%);
    opacity: 0;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .stage {
      justify-self: center;
    }
  }
</style>
