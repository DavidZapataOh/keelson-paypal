{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedDeclarations": false,
    "declaration": false,
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "app",
    "components",
    "lib",
    "test",
    "next.config.ts",
    "csp.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out"]
}
