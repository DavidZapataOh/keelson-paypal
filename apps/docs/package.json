{
  "name": "@keelson/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "pnpm prepare && astro dev",
    "build": "pnpm prepare && astro build && pagefind --site dist",
    "typecheck": "pnpm prepare && astro sync && tsc",
    "test": "vitest run --exclude '**/*.live.test.ts' --exclude 'test/e2e/**'",
    "e2e": "vitest run test/e2e --exclude '**/*.live.test.ts'",
    "test:live": "vitest run test/*.live.test.ts test/e2e/*.live.test.ts"
  },
  "dependencies": {
    "@astrojs/markdoc": "2.1.3",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.6.6",
    "pagefind": "1.6.0",
    "playwright": "1.64.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
