---
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import instrumentSans from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import "../styles/base.css";
import "../styles/theme.css";
import Search from "../components/Search.astro";
import { builtOn, live } from "../lib/live";
import { type NavSection, nav } from "../lib/docs";

interface Props {
  title: string;
  description: string;
  current: string;
  home?: boolean;
  /** Replaces the side navigation, as the API reference does with its operations. */
  sidebar?: NavSection[];
}
const { title, description, current, home = false, sidebar } = Astro.props;
const sections = await nav();
const side = sidebar ?? sections;
const operational = live.available && live.status === "ok";
// `optional` with the preload above never swaps a late font in, so text never reflows.
const latin =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const fontFaces = [
  ["Instrument Sans Variable", "400 700", instrumentSans],
  ["Geist Mono Variable", "100 900", geistMono],
]
  .map(
    ([family, weight, src]) =>
      `@font-face{font-family:"${family}";font-style:normal;font-display:optional;font-weight:${weight};src:url(${src}) format("woff2-variations");unicode-range:${latin}}`,
  )
  .join("");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{home ? title : `${title} · Keelson docs`}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={instrumentSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script is:inline>
      {
        const stored = localStorage.getItem("keelson-docs-theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      {!home && (
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="sidenav" data-menu>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <span class="visually-hidden">Menu</span>
        </button>
      )}
      <a class="brand" href="/"><img src="/keelson.svg" alt="Keelson" width="86" height="26" /><span class="brand-sub">Docs</span></a>
      <nav class="topnav" aria-label="Sections">
        {sections.map((s) => (
          <a href={s.items[0]?.href} aria-current={!home && (s.items.some((i) => i.href === current) || (s.section === "Reference" && current.startsWith("/reference/api/"))) ? "true" : undefined}>{s.section}</a>
        ))}
      </nav>
      <div class="top-tools">
        <Search />
        <button class="theme-toggle" type="button" aria-label="Switch between light and dark" data-theme-toggle>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" /></svg>
        </button>
        <a class="top-link" href="https://app.keelson.finance/judge">Judge Mode</a>
      </div>
    </header>
    <div class:list={["frame", { "frame-home": home }]}>
      {!home && (
        <nav class="sidenav" id="sidenav" aria-label="Documentation">
          {side.map((s) => (
            <div class="nav-group">
              <p class="nav-label">{s.section}</p>
              <ul>
                {s.items.map((i) => (
                  <li><a href={i.href} aria-current={i.href === current ? "page" : undefined}>{i.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
          {live.available && (
            <a class="nav-status" href="https://app.keelson.finance/status">
              <span class:list={["dot", { down: !operational }]} aria-hidden="true"></span>
              {operational ? "Operational at build" : "Degraded at build"}
              <small>{builtOn(live.fetchedAt)} · log size {live.log.size.toLocaleString("en-US")}</small>
            </a>
          )}
        </nav>
      )}
      <main id="main" class="main"><slot /></main>
    </div>
    <script>
      const menu = document.querySelector<HTMLButtonElement>("[data-menu]");
      menu?.addEventListener("click", () => {
        const open = menu.getAttribute("aria-expanded") !== "true";
        menu.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("menu-open", open);
      });
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("keelson-docs-theme", next);
      });
    </script>
  </body>
</html>
