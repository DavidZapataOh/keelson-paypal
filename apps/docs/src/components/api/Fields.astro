---
import { inline, type Schema } from "../../lib/openapi";

interface Props {
  schema?: Schema;
}
const { schema } = Astro.props;
const typeOf = (s: Schema) => {
  const t = Array.isArray(s.type) ? s.type.filter((x) => x !== "null").join(" | ") : s.type;
  if (t === "array")
    return `array of ${s.items?.type ?? (s.items?.properties ? "object" : "values")}`;
  return t ?? (s.properties ? "object" : s.enum ? "enum" : s.oneOf || s.anyOf ? "one of" : "value");
};
const fields = Object.entries(schema?.properties ?? {});
---
{fields.length > 0 && (
  <dl class="params">
    {fields.map(([name, s]) => (
      <div class="param">
        <dt>
          <code>{name}</code>
          <span class="param-type">{typeOf(s)}</span>
          {schema?.required?.includes(name) && <span class="param-req">Required</span>}
        </dt>
        {(s.description || s.enum) && (
          <dd>
            {s.description && <span set:html={inline(s.description)} />}
            {s.enum && <span class="param-enum">One of {s.enum.map((v) => <code>{String(v)}</code>)}</span>}
          </dd>
        )}
      </div>
    ))}
  </dl>
)}
