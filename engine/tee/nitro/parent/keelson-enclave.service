[Unit]
Description=Keelson engine enclave
After=nitro-enclaves-allocator.service docker.service
Requires=nitro-enclaves-allocator.service

[Service]
Environment=NITRO_CLI_ARTIFACTS=/var/lib/keelson NITRO_CLI_BLOBS=/usr/share/nitro_enclaves/blobs
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/nitro-cli terminate-enclave --all
ExecStart=/usr/bin/nitro-cli run-enclave --eif-path /opt/keelson/keelson.eif --cpu-count 2 --memory 1024 --enclave-cid 16
ExecStop=/usr/bin/nitro-cli terminate-enclave --all

[Install]
WantedBy=multi-user.target
