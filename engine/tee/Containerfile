# Build from the repository root:
#   docker buildx build -f engine/tee/Containerfile .

FROM docker.io/stagex/core-ca-certificates:sx2026.11.0@sha256:2e5d0da04413dfbc739f3009fe6616e90e733c463f8495ce6997b02c0832735c AS ca

FROM docker.io/stagex/pallet-rust:sx2026.11.0@sha256:4f12174acd7ccab9506e20a986c556cd5837dbd0ce616abf3031bcaaaa365590 AS build
ENV CARGO_HOME=/cargo
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY engine/ ./engine/
RUN cargo fetch --locked --target x86_64-unknown-linux-musl
# StageX's Rust links musl dynamically unless asked otherwise. Crate-local ThinLTO over 16
# codegen units names promoted symbols after a hash of each unit's bitcode, which LLVM does not
# produce deterministically (rust-lang/rust#165355); one unit with fat LTO, symbols stripped.
RUN --network=none <<EOF
    set -eu
    RUSTFLAGS="-C target-feature=+crt-static" \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_LTO=fat \
    CARGO_PROFILE_RELEASE_STRIP=symbols \
    cargo build \
        --frozen \
        --release \
        --target x86_64-unknown-linux-musl \
        --package keelson-tee \
        --features tdx \
        --bin keelson-engine
    cp target/x86_64-unknown-linux-musl/release/keelson-engine /keelson-engine
EOF

FROM scratch
LABEL org.opencontainers.image.source="https://github.com/DavidZapataOh/keelson-paypal"
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /keelson-engine /keelson-engine
USER 65534:65534
EXPOSE 8080
ENTRYPOINT ["/keelson-engine"]
CMD ["--listen", "tcp:0.0.0.0:8080"]
