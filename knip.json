    },
    "packages/evidence": {
      "entry": ["src/index.ts!", "src/capture/index.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/log": {
      "entry": ["src/index.ts!", "scripts/*.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/mandate": {
      "entry": ["src/index.ts!", "src/browser.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
