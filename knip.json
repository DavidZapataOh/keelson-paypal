    "apps/verify": {
      "entry": ["src/main.tsx!", "vite.config.ts", "vitest.config.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.ts", "bench/**/*.ts"]
