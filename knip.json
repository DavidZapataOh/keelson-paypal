    "packages/timestamp": {
      "entry": ["src/index.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
