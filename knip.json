      "entry": ["src/server.ts!", "src/workflows.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
