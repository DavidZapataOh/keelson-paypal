        "bench/*.bench.ts"
      ],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts", "bench/**/*.ts"]
    },
    "packages/attest": {
      "entry": ["src/index.ts!", "src/server/collateral.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/chain": {
      "entry": ["src/index.ts!", "scripts/generate.ts"],
