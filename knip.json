{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["contracts/**", "packages/sdk-python/**"],
  "workspaces": {
    "apps/docs": {
      "entry": ["scripts/data.mjs!", "astro.config.mjs!", "markdoc.config.mjs!", "test/**/*.ts"],
      "project": ["src/**/*.{ts,astro}!", "scripts/**/*.mjs!", "test/**/*.ts"],
      "ignoreUnresolved": ["/pagefind/pagefind.js"],
      "ignoreDependencies": ["@astrojs/markdoc"]
    },
    "engine/tee": {
      "entry": ["scripts/*.ts!"],
      "project": ["scripts/**/*.ts!"]
    },
    "packages/alibi": {
      "entry": [
        "src/index.ts!",
        "src/verify/index.ts!",
        "src/pdf.ts!",
        "src/extract.ts!",
        "scripts/*.ts",
        "bench/*.bench.ts"
      ],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts", "bench/**/*.ts"]
    },
    "packages/attest": {
      "entry": ["src/index.ts!", "src/server/collateral.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/chain": {
      "entry": ["src/index.ts!", "scripts/generate.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/compiler": {
      "entry": ["src/index.ts!", "eval/run.ts"],
      "project": ["src/**/*.ts!", "eval/**/*.ts", "test/**/*.ts"]
    },
    "packages/core": {
      "entry": [
        "src/index.ts!",
        "src/poseidon2.ts!",
        "src/eip712.ts!",
        "src/amber.ts!",
        "bench/*.bench.ts"
      ],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/index.ts!", "src/migrate.ts!", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/erc8004": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/evidence": {
      "entry": ["src/index.ts!", "src/capture/index.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/log": {
      "entry": ["src/index.ts!", "scripts/*.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/mandate": {
      "entry": ["src/index.ts!", "src/browser.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/paypal": {
      "entry": [
        "src/index.ts!",
        "src/browser.ts!",
        "src/testing.ts!",
        "scripts/*.ts",
        "test/sandbox/*.sandbox.test.ts"
      ],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/policy": {
      "entry": ["src/index.ts!", "src/generated/hashes.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/relayer": {
      "entry": ["src/index.ts!", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "bench/**/*.ts", "test/**/*.ts"]
    },
    "packages/timestamp": {
      "entry": ["src/index.ts!", "scripts/*.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "apps/store": {
      "entry": ["src/server.ts!", "public/checkout.js!", "bench/*.bench.ts"],
      "project": ["src/**/*.ts!", "public/**/*.js!", "test/**/*.ts", "bench/**/*.ts"]
    },
    "packages/ui": {
      "entry": [
        "src/components/*.tsx!",
        "src/lib/*.ts!",
        "src/tokens.ts!",
        "src/studio.ts!",
        "test/fixture/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.{ts,tsx}"]
    },
    "apps/verify": {
      "entry": ["src/main.tsx!", "vite.config.ts", "vitest.config.ts", "bench/*.bench.ts"],
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.ts", "bench/**/*.ts"],
      "ignoreDependencies": ["@keelson/ui"]
    },
    "apps/web": {
      "entry": [
        "app/**/{page,layout}.tsx!",
        "next.config.ts",
        "postcss.config.mjs",
        "vitest.config.ts",
        "csp.ts!"
      ],
      "project": ["app/**/*.tsx!", "components/**/*.tsx!", "lib/**/*.ts!", "test/**/*.ts"]
    },
    "services/api": {
      "entry": [
        "src/server.ts!",
        "src/workflows.ts!",
        "scripts/bridge-backfill.ts!",
        "scripts/*.ts",
        "bench/*.bench.ts"
      ],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
    },
    "services/agent": {
      "entry": ["src/index.ts!", "scripts/*.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "services/redteam": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "services/mcp": {
      "entry": ["src/index.ts!", "src/stdio.ts!", "view/alibi.ts!", "scripts/*.ts"],
      "project": ["src/**/*.ts!", "view/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "services/monitor": {
      "entry": [".railway/railway.ts", "scripts/*.ts", "test/**/*.test.ts", "web/app.js"],
      "project": ["scripts/**/*.ts", "test/**/*.ts", "web/**/*.js"]
    },
    "services/witness": {
      "entry": [".railway/railway.ts"]
    },
    "packages/scitt": {
      "entry": ["src/index.ts!", "src/testing.ts!", "scripts/*.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/sdk": {
      "entry": ["src/index.ts!", "src/cli.ts!", "src/adapters/*.ts!", "scripts/*.ts", "examples/*"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts", "examples/**"]
    },
    "packages/verify": {
      "entry": ["scripts/*.mjs", "src/cli.ts!", "src/index.ts!"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/context": {
      "entry": ["src/index.ts!", "src/stdio.ts!", "scripts/*.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"]
    }
  }
}
