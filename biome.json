{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/target",
      "!openapi",
      "!**/rfc8785",
      "!**/test/vectors",
      "!**/tests/vectors",
      "!**/vendor",
      "!**/test/evidence",
      "!**/test/snapshots",
      "!engine/tee/measurements.json",
      "!apps/web/public/redteam",
      "!engine/tee/measurements-rotation.json",
      "!engine/tee/zk",
      "!services/api/zk",
      "!**/src/generated",
      "!engine/policy/proofs",
      "!contracts/lib",
      "!contracts/out",
      "!contracts/cache",
      "!contracts/broadcast",
      "!contracts/snapshots",
      "!packages/sdk-python",
      "!packages/context/src/corpus.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useImportType": "off"
          }
        }
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/verify/src/styles.css"],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/components/field.tsx",
        "packages/ui/src/components/input-group.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/styles/globals.css"],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      },
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/landing/src/styles/global.css", "services/mcp/view/alibi.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/sdk/examples/quickstart.mjs"],
      "formatter": {
        "lineWidth": 160
      }
    }
  ]
}
