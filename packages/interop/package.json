{
  "name": "@keelson/interop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./visa-pdf": {
      "types": "./dist/visa-pdf.d.ts",
      "node": "./dist/visa-pdf.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "bindings.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vendor": "node scripts/vendor.ts",
    "bindings": "node scripts/bindings-json.ts",
    "conformance": "node conformance/write-exports.ts && uv run --python 3.12 --project conformance python conformance/verify.py",
    "bench": "node bench/exports.bench.ts"
  },
  "dependencies": {
    "@keelson/alibi": "workspace:*",
    "@keelson/core": "workspace:*",
    "@keelson/log": "workspace:*",
    "@keelson/mandate": "workspace:*",
    "@keelson/scitt": "workspace:*",
    "@noble/hashes": "catalog:",
    "@sd-jwt/core": "0.24.3",
    "http-message-sig": "0.3.0",
    "jose": "6.2.15",
    "pdfkit": "0.20.2",
    "structured-headers": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pdfkit": "0.17.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pdfjs-dist": "6.4.299",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web-bot-auth": "0.2.0"
  }
}
