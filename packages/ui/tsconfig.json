{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedDeclarations": false,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
