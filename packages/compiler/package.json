  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@keelson/core": "workspace:*",
    "@keelson/mandate": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@keelson/policy": "workspace:*",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
