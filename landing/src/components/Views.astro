---
const mandate = "shoes · size 10 · max $100 · by Fri";
const rows = [
  { label: "What the user signed", merchant: null, operator: mandate, dispute: mandate },
  { label: "Price inside the mandate", merchant: "yes · checked by Keelson", operator: "yes · checked by Keelson", dispute: "yes · checked by Keelson" },
  { label: "Who stated the size", merchant: null, operator: "operator · bonded", dispute: "operator · bonded" },
  { label: "Countersigned", merchant: "Mon 09:14:07 UTC", operator: "Mon 09:14:07 UTC", dispute: "Mon 09:14:07 UTC" },
  { label: "Party at fault", merchant: null, operator: null, dispute: "operator · bond pays $94" },
];
const views = [
  { key: "merchant", name: "Merchant", note: "Receives the order" },
  { key: "operator", name: "Agent operator", note: "Placed the order" },
  { key: "dispute", name: "Dispute", note: "A field is opened" },
] as const;
---

<section class="section views" id="views" aria-labelledby="views-title">
  <div class="wrap">
    <div class="head">
      <h2 id="views-title">Same purchase.<br />Three different views.</h2>
      <p>
        The Alibi shows each party only what it needs. The mandate stays sealed until a dispute
        needs a field opened, and then it shows who answers for it.
      </p>
    </div>

    <div class="stage" id="views-stage" data-ready="false">
      <canvas width="1080" height="430" aria-hidden="true"></canvas>
    <div class="windows">
      {
        views.map((v) => (
          <article class="win" data-view={v.key}>
            <header>
              <h3 class="mono">{v.name}</h3>
              <span class="mono who">{v.note}</span>
            </header>
            <dl>
              {rows.map((r) => {
                const value = r[v.key];
                return (
                  <div class="row">
                    <dt class="mono">{r.label}</dt>
                    <dd>
                      {value === null ? (
                        <>
                          <span class="bar closed" aria-hidden="true" />
                          <span class="sr">Hidden</span>
                        </>
                      ) : (
                        <>
                          <span class="val mono">{value}</span>
                          <span class="bar cover" aria-hidden="true" />
                        </>
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>
          </article>
        ))
      }
    </div>
    </div>
    <p class="foot mono">Synthetic example. The Alibi carries claims and hashes; the mandate itself is never published.</p>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 28px;
    max-width: 880px;
  }

  h2 {
    font-size: clamp(2.6rem, 6vw, 5.6rem);
  }

  .head p {
    max-width: 52ch;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .stage {
    position: relative;
    margin-top: clamp(48px, 6vw, 88px);
  }

  .stage canvas {
    display: none;
  }

  .stage[data-ready="true"] canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1080 / 430;
  }

  /* the windows stay as the page's text, and show instead of the scene below 1180px */
  .stage[data-ready="true"] .windows {
    position: absolute;
    inset: 0;
    clip-path: inset(50%);
    opacity: 0;
  }

  .windows {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .win {
    padding: 24px;
    border: 1.5px solid var(--graphite);
    border-radius: var(--radius-l);
    background: color-mix(in srgb, var(--bone) 86%, white);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--vermilion);
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .who {
    font-size: 0.75rem;
    color: var(--text-2);
  }

  dl {
    margin: 0;
  }

  .row {
    display: grid;
    gap: 8px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  dt {
    font-size: 0.75rem;
    color: var(--text-2);
  }

  dd {
    position: relative;
    margin: 0;
    min-height: 26px;
    display: flex;
    align-items: center;
  }

  .val {
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .bar {
    display: block;
    background: var(--graphite);
    border-radius: 2px;
  }

  .closed {
    width: 100%;
    height: 22px;
  }

  .cover {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: right;
  }

  .foot {
    margin-top: 24px;
    font-size: 0.8rem;
    color: var(--text-2);
  }

  @media (max-width: 960px) {
    .windows {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
