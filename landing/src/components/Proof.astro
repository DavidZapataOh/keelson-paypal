---
const checks = [
  { claim: "Signed by the user, inside the mandate.", inputs: "mandateHash, passkeyAssertion" },
  { claim: "Checked by code that can prove what it ran.", inputs: "attestation, policyHash, cartHash" },
  { claim: "Recorded where no one can rewrite it.", inputs: "logIndex, inclusionProof, checkpoint" },
];
---

<section class="section proof" id="proof" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="head">
      <h2 id="proof-title">Proof, not logs.</h2>
      <p>
        A signed log only proves who wrote it. Rewrite an entry and re-sign it, and the signature
        still checks out. Keelson's record is a Merkle log whose root is published on-chain, so a
        rewrite breaks the math instead.
      </p>
    </div>

    <figure class="stage" id="proof-stage" data-ready="false">
      <div class="frame">
        <canvas id="proof-rive" width="760" height="460" aria-hidden="true"></canvas>
        <div class="fallback mono" aria-hidden="true">
          <p><span>#1203</span> USER APPROVED $340.00</p>
          <p><span>Signature</span> valid · re-signed by the operator</p>
          <p><span>Computed root</span> 4c07…b88d</p>
          <p><span>Published root</span> 9f3a…c21e</p>
          <p class="verdict">Rewrite detected · #1203</p>
        </div>
      </div>
      <figcaption>
        <p class="sr" id="proof-live" aria-live="polite">
          The order's record verifies: its root matches the checkpoint published on-chain.
        </p>
        <div class="controls" role="group" aria-label="Try to rewrite the record">
          <button class="toggle" type="button" data-value="false" aria-pressed="true">
            <i class="dot ok" aria-hidden="true"></i>Verify the record
          </button>
          <button class="toggle" type="button" data-value="true" aria-pressed="false">
            <i class="dot bad" aria-hidden="true"></i>Rewrite entry #1203
          </button>
        </div>
        <span class="note mono">Synthetic demonstration</span>
      </figcaption>
    </figure>

    <ol class="checks" aria-label="What every purchase proves before it is paid">
      {
        checks.map((c) => (
          <li>
            <p class="claim">{c.claim}</p>
            <p class="inputs mono">
              <span>Public inputs</span>
              {c.inputs}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 20px;
    max-width: 62ch;
  }

  h2 {
    font-size: clamp(2.5rem, 6vw, 5.25rem);
  }

  .head p {
    color: var(--text-2);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    max-width: 52ch;
  }

  .stage {
    margin: clamp(40px, 5vw, 64px) auto 0;
    max-width: 1080px;
  }

  .frame {
    position: relative;
    aspect-ratio: 760 / 460;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }

  .stage[data-ready="true"] canvas {
    opacity: 1;
  }

  .fallback {
    position: absolute;
    inset: 4% 3%;
    display: grid;
    align-content: center;
    gap: 12px;
    padding: 28px;
    border: 1.5px solid var(--graphite);
    border-radius: var(--radius-l);
    background: var(--bone);
    font-size: clamp(0.8rem, 1.1vw, 1rem);
    transition: opacity 300ms ease;
  }

  .fallback span {
    display: inline-block;
    min-width: 16ch;
    color: var(--text-2);
  }

  .fallback .verdict {
    justify-self: start;
    margin-top: 8px;
    padding: 4px 10px;
    background: var(--vermilion);
    text-transform: uppercase;
  }

  .stage[data-ready="true"] .fallback {
    opacity: 0;
    visibility: hidden;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-top: 12px;
    padding-inline: 2.6%;
  }

  .controls {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--bone);
  }

  .stage[data-ready="false"] .controls {
    display: none;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    font: 500 0.92rem / 1 var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-hover) ease,
      color var(--dur-hover) ease;
  }

  .toggle:hover {
    color: var(--graphite);
  }

  .toggle[aria-pressed="true"] {
    background: var(--graphite);
    color: var(--bone);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot.ok {
    background: #4fbf8f;
  }

  .dot.bad {
    background: var(--vermilion);
  }

  .note {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .checks {
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1.5px solid var(--graphite);
    counter-reset: check;
  }

  .checks li {
    padding: 24px 24px 0 0;
    counter-increment: check;
  }

  .checks li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .claim {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    max-width: 24ch;
  }

  .inputs {
    margin-top: 14px;
    font-size: 0.82rem;
    color: var(--graphite);
  }

  .inputs span {
    display: block;
    margin-bottom: 4px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  @media (max-width: 700px) {
    .frame {
      aspect-ratio: 360 / 900;
    }
  }

  @media (max-width: 820px) {
    .checks {
      grid-template-columns: 1fr;
    }

    .checks li,
    .checks li + li {
      padding: 20px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }

    .stage {
      margin-inline: calc(var(--gutter) * -0.6);
    }

    .toggle {
      padding: 0 12px;
      font-size: 0.85rem;
    }
  }
</style>
