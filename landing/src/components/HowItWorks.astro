<section class="section how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title">Three steps.<br />Proof before <span class="hl">payment.</span></h2>

    <div class="steps" id="steps">

      <article class="step" data-step="1">
        <header>
          <span class="num mono">01</span>
          <h3>Sign</h3>
        </header>
        <p>
          You sign a mandate once, with a passkey: what to buy, the most to spend, where, and by
          when.
        </p>
        <div class="fig-stage" id="fig-1" data-artboard="StepSign" data-ready="false">
          <canvas width="360" height="220" aria-hidden="true"></canvas>
          <svg class="fig" viewBox="0 0 360 220" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
          <g class="key">
            <circle cx="62" cy="64" r="24" fill="var(--bone)" />
            <circle cx="62" cy="64" r="6" />
            <path fill="var(--bone)" d="M57 88v82l5 8 5-8v-14l-9-4 9-4v-8l-6-3 6-3V88Z" />
          </g>
          <rect x="140" y="72" width="80" height="76" rx="6" fill="var(--bone)" />
          <path class="check" d="M162 112l13 14 24-30" stroke-width="2" pathLength="1" />
          <g class="key">
            <circle cx="298" cy="64" r="24" fill="var(--bone)" />
            <circle cx="298" cy="64" r="6" />
            <path fill="var(--bone)" d="M293 88v82l5 8 5-8v-14l-9-4 9-4v-8l-6-3 6-3V88Z" />
          </g>
        </svg>
        </div>
      </article>

      <article class="step" data-step="2">
        <header>
          <span class="num mono">02</span>
          <h3>Check</h3>
        </header>
        <p>Before anything is paid, Keelson checks the agent's cart against the mandate, field by field.</p>
        <div class="fig-stage" id="fig-2" data-artboard="StepCheck" data-ready="false">
          <canvas width="360" height="220" aria-hidden="true"></canvas>
          <svg class="fig" viewBox="0 0 360 220" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="30" y="38" width="120" height="144" rx="8" fill="var(--bone)" />
          <g class="bars" fill="currentColor" stroke="none">
            <rect x="48" y="62" width="84" height="12" />
            <rect x="48" y="86" width="56" height="12" />
            <rect x="48" y="110" width="76" height="12" />
            <rect x="48" y="134" width="44" height="12" />
          </g>
          <path d="M172 102h16M172 118h16" stroke-width="2" />
          <rect x="210" y="38" width="120" height="144" rx="8" fill="var(--bone)" />
          <g class="bars" fill="currentColor" stroke="none">
            <rect x="228" y="62" width="84" height="12" />
            <rect x="228" y="86" width="56" height="12" />
            <rect x="228" y="110" width="76" height="12" />
            <rect x="228" y="134" width="44" height="12" />
          </g>
        </svg>
        </div>
      </article>

      <article class="step" data-step="3">
        <header>
          <span class="num mono">03</span>
          <h3>Pay</h3>
        </header>
        <p>
          If it matches, Keelson countersigns and PayPal takes the payment with the Alibi attached.
          Otherwise nothing is paid.
        </p>
        <div class="fig-stage" id="fig-3" data-artboard="StepPay" data-ready="false">
          <canvas width="360" height="220" aria-hidden="true"></canvas>
          <svg class="fig" viewBox="0 0 360 220" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <g class="pane pane-l">
            <rect x="74" y="30" width="66" height="160" rx="8" fill="var(--bone)" />
            <path d="M88 96h38M88 106h38M88 116h38" stroke-dasharray="5 4" />
          </g>
          <g class="pane pane-r">
            <rect x="196" y="30" width="66" height="160" rx="8" fill="var(--bone)" />
            <path d="M210 96h38M210 106h38M210 116h38" stroke-dasharray="5 4" />
          </g>
        </svg>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(2.6rem, 6vw, 5.6rem);
    max-width: 14ch;
  }

  .steps {
    position: relative;
    margin-top: clamp(56px, 8vw, 112px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    column-gap: clamp(24px, 4vw, 56px);
  }

  .step {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / span 3;
    padding-left: clamp(0px, 1.6vw, 24px);
  }

  .step[data-step="1"] {
    grid-column: 1;
  }

  .step[data-step="2"] {
    grid-column: 2;
  }

  .step[data-step="3"] {
    grid-column: 3;
  }

  .step + .step {
    border-left: 1px solid var(--line);
    padding-left: clamp(20px, 2.6vw, 40px);
  }

  header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .num {
    display: inline-grid;
    place-items: center;
    min-width: 48px;
    height: 48px;
    border: 1.5px solid var(--graphite);
    border-radius: var(--radius-s);
    font-size: 1.1rem;
  }

  h3 {
    font-size: clamp(1.7rem, 2.6vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .step p {
    margin-bottom: 28px;
    max-width: 30ch;
    color: var(--text-2);
  }

  .fig-stage {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 360 / 220;
  }

  .fig-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }

  .fig-stage[data-ready="true"] canvas {
    opacity: 1;
  }

  .fig-stage[data-ready="true"] .fig {
    visibility: hidden;
  }

  .fig {
    width: 100%;
    height: 100%;
    overflow: visible;
  }




  .check {
    stroke-dasharray: 1;
    stroke-dashoffset: var(--check, 0);
  }

  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(9, auto);
    }

    .step[data-step] {
      grid-column: 1;
      grid-row: auto;
      grid-template-rows: auto auto auto;
      padding: 0 0 56px;
    }

    .step + .step {
      border-left: 0;
      padding-left: 0;
    }

    .fig-stage {
      max-width: 420px;
    }
  }
</style>
